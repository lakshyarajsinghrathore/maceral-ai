# Maceral AI - Backend Environment Template

# AI Models
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration (Supabase PostgreSQL in production, SQLite in local dev)
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./coal_intelligence.db

# Supabase REST Credentials (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Application Settings
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Security
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads
GENERATED_REPORTS_DIR=./generated_reports
